# Umbrella Environment Configuration Example
# Copy to .env or .env.local for local overrides

# Backend API Configuration
UMBRELLA_HOST=127.0.0.1
UMBRELLA_PORT=8000
UMBRELLA_DEBUG=false

# Weather Data Provider (LIVE vs MOCK)
WEATHER_PROVIDER_MODE=LIVE
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Frontend API URL
NEXT_PUBLIC_UMBRELLA_API_URL=http://localhost:8000
